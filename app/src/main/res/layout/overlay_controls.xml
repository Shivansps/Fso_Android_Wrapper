<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/overlay_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="false"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="false"
    android:layoutDirection="ltr"
    android:splitMotionEvents="true"
    tools:ignore="HardcodedText">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBarScroller"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:clipChildren="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <HorizontalScrollView
            android:id="@+id/topBarLeftScroller"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnToggle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:id="@+id/topBarLeft"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="end|top"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn0"
                    style="@style/Widget.FSOWrapper.HudButton"
                    android:text="0" />

                <Button
                    android:id="@+id/btnF1"
                    style="@style/Widget.FSOWrapper.HudButton"
                    android:text="F1" />

                <Button
                    android:id="@+id/btnF2"
                    style="@style/Widget.FSOWrapper.HudButton"
                    android:text="F2" />

                <Button
                    android:id="@+id/btnF3"
                    style="@style/Widget.FSOWrapper.HudButton"
                    android:text="F3" />

                <Button
                    android:id="@+id/btnF4"
                    style="@style/Widget.FSOWrapper.HudButton"
                    android:text="F4" />

                <Button
                    android:id="@+id/btnEsc"
                    style="@style/Widget.FSOWrapper.HudButton"
                    android:minWidth="52dp"
                    android:text="ESC" />
            </LinearLayout>
        </HorizontalScrollView>

        <Button
            android:id="@+id/btnToggle"
            style="@style/Widget.FSOWrapper.HudButton"
            android:contentDescription="Show or hide touch control groups"
            android:minWidth="38dp"
            android:text="≡"
            android:textSize="18sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <HorizontalScrollView
            android:id="@+id/topBarRightScroller"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/btnToggle"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:id="@+id/topBarRight"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="start|top"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnKyb"
                    style="@style/Widget.FSOWrapper.HudButton"
                    android:minWidth="56dp"
                    android:text="KEYB" />

                <Button
                    android:id="@+id/btnAltJ"
                    style="@style/Widget.FSOWrapper.HudButton"
                    android:text="ALT+J" />

                <Button
                    android:id="@+id/btnAltM"
                    style="@style/Widget.FSOWrapper.HudButton"
                    android:text="ALT-M" />

                <Button
                    android:id="@+id/btnAltH"
                    style="@style/Widget.FSOWrapper.HudButton"
                    android:text="ALT-H" />

                <Button
                    android:id="@+id/btnAltA"
                    style="@style/Widget.FSOWrapper.HudButton"
                    android:text="ALT-A" />
            </LinearLayout>
        </HorizontalScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.shivansps.fsowrapper.overlay.RadialActionView
        android:id="@+id/communicationWheel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="Communication controls"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="W,1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_max="140dp"
        app:layout_constraintHeight_percent="0.24"
        app:layout_constraintHorizontal_bias="0.10"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBarScroller"
        app:layout_constraintVertical_bias="0.06" />

    <com.shivansps.fsowrapper.overlay.RadialActionView
        android:id="@+id/targetWheel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="Targeting controls"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="W,1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_max="160dp"
        app:layout_constraintHeight_percent="0.27"
        app:layout_constraintHorizontal_bias="0.86"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBarScroller"
        app:layout_constraintVertical_bias="0.06" />

    <com.shivansps.fsowrapper.overlay.RadialDpadView
        android:id="@+id/dpad"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clickable="true"
        android:contentDescription="Direction control with TAB outer ring"
        android:focusable="false"
        android:layout_marginBottom="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="W,1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_max="330dp"
        app:layout_constraintHeight_percent="0.58"
        app:layout_constraintHorizontal_bias="0.01"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBarScroller"
        app:layout_constraintVertical_bias="1" />

    <com.shivansps.fsowrapper.overlay.RadialActionView
        android:id="@+id/weaponWheel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="Weapon and ship controls"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="W,1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_max="280dp"
        app:layout_constraintHeight_percent="0.50"
        app:layout_constraintHorizontal_bias="0.91"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBarScroller"
        app:layout_constraintVertical_bias="1" />

</androidx.constraintlayout.widget.ConstraintLayout>
